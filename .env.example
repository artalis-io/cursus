# OTTO source used for every native build. Relative paths resolve from this file.
OTTO_ROOT=./vendor/otto
OTTO_REVISION=367061d015f6776f7ea27fb01726c1a14cb4614c

# Existing host directories. Compose deliberately does not create them.
CURSUS_DATASET_PATH=/absolute/path/to/customer-dataset
CURSUS_DATA_PATH=/absolute/path/to/cursus-state
CURSUS_DATASET_ID=customer-dataset
OSM_DATA_PATH=/absolute/path/to/osm-assets

OSM_PBF_FILE=hungary-latest.osm.pbf
OSM_PBF_URL=https://download.geofabrik.de/europe/hungary-latest.osm.pbf
OSM_ASSET_NAME=hungary

CURSUS_PORT=8091
CURSUS_UID=10001
CURSUS_GID=10001
CURSUS_PUBLIC_ORIGIN=https://cursus.artalis.io
CURSUS_AUTH_FROM=Cursus <login@cursus.artalis.io>
CURSUS_TENANT_ID=demo
CURSUS_TENANT_NAME=Cursus Demo
# Existing host files, kept outside Git. One approved email per line; never
# place addresses or the Resend key in this repository.
CURSUS_AUTH_ALLOWLIST_PATH=/absolute/path/to/cursus-auth-allowlist
RESEND_API_KEY_PATH=/absolute/path/to/resend-api-key
DISPATCH_CORS_ORIGINS=
DISPATCH_SOLVE_SECONDS=240
# Always population search, three generations. Threads per simultaneous solve
# (1..16); bound this alongside worker concurrency. No single-search toggle.
DISPATCH_SOLVE_THREADS=4
DISPATCH_GEOCODE_OFFLINE=1
COMPOSE_PROJECT_NAME=cursus

# Stateful runtime integration (not enabled by the production Compose stack
# until the PR #10 cutover gates are complete). Production object storage is
# Cloudflare R2; credentials must remain in external secret files/environment.
CURSUS_RUNTIME_MODE=legacy
CURSUS_DATABASE_URL=postgres://cursus:change-me@postgres/cursus
CURSUS_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
CURSUS_R2_BUCKET=cursus
CURSUS_R2_ACCESS_KEY_ID_FILE=/run/secrets/r2_access_key_id
CURSUS_R2_SECRET_ACCESS_KEY_FILE=/run/secrets/r2_secret_access_key
