# Copy to each node as /home/lab/cursus-production/.env.production (mode 0600).
# Values differ only where explicitly noted. Never commit the populated file.
COMPOSE_PROJECT_NAME=cursus-production-primary
CURSUS_NODE_NAME=spark-7468-production
CURSUS_REVISION=replace-with-cursus-git-sha
OTTO_REVISION=acb8251c0751f30683c51841c1f28c7b1bb00b75
OTTO_ROOT=./vendor/otto

# During Provision/Deploy use 18101 on the primary and 18102 on the standby.
# The gated activation changes this to 8080 one drained origin at a time.
CURSUS_STAGING_PORT=18101
CURSUS_STAGING_STATE_PATH=/srv/cursus-production/state
CURSUS_DATASET_PATH=/absolute/path/to/external-customer-dataset
OSM_DATA_PATH=/srv/cursus-production/osm
OSM_ASSET_NAME=hungary
OSM_PBF_FILE=hungary-latest.osm.pbf

# Primary and standby use separate local data/backup/restore directories.
# Bind PostgreSQL only to a trusted private node address.
CURSUS_POSTGRES_BIND_IP=192.0.2.10
CURSUS_POSTGRES_HOST_PORT=55433
CURSUS_POSTGRES_DATA_PATH=/srv/cursus-production/postgres
CURSUS_POSTGRES_BACKUP_PATH=/srv/cursus-production/postgres-backups
CURSUS_POSTGRES_RESTORE_PATH=/srv/cursus-production/postgres-restore-drill
CURSUS_POSTGRES_PASSWORD_PATH=/srv/cursus-production/secrets/postgres_password
CURSUS_POSTGRES_REPLICATION_PASSWORD_PATH=/srv/cursus-production/secrets/postgres_replication_password
CURSUS_DATABASE_URL_PATH=/srv/cursus-production/secrets/database_url
CURSUS_REPLICATION_CIDR=192.0.2.0/24
CURSUS_PRIMARY_HOST=192.0.2.10
CURSUS_PRIMARY_PORT=55433

# Use a production-only R2 bucket and bucket-scoped token. The endpoint contains
# the Cloudflare account ID; credential values live only in the external files.
CURSUS_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
CURSUS_R2_BUCKET=replace-with-production-bucket
CURSUS_R2_ACCESS_KEY_ID_PATH=/srv/cursus-production/secrets/r2_access_key_id
CURSUS_R2_SECRET_ACCESS_KEY_PATH=/srv/cursus-production/secrets/r2_secret_access_key

CURSUS_AUTH_REQUIRED=1
CURSUS_AUTH_ALLOWED_EMAILS_PATH=/srv/cursus-production/secrets/auth_allowlist
RESEND_API_KEY_PATH=/srv/cursus-production/secrets/resend_api_key
CURSUS_PUBLIC_ORIGIN=https://cursus.artalis.io
CURSUS_AUTH_FROM=Cursus <login@cursus.artalis.io>
CURSUS_TENANT_ID=production
# Human-readable workspace label. Keep the ID stable when changing this name.
CURSUS_TENANT_NAME=Cursus

# Optional trusted inference endpoint reachable from the app container.
# localhost here means the container, NOT the Spark host. No inference service
# is installed or started by this deployment. Never use an unapproved external
# provider: summary prompts contain tenant plan figures and vehicle references.
SAGE_ORIGIN=http://127.0.0.1:8084
SAGE_MODEL=sgdflash

CURSUS_APP_CPUS=12
CURSUS_APP_MEMORY=32g
CURSUS_VELO_CPUS=4
CURSUS_VELO_MEMORY=8g
CURSUS_CARTA_CPUS=2
CURSUS_CARTA_MEMORY=4g
DISPATCH_MAX_CONCURRENT_SOLVES=1
DISPATCH_MAX_CONCURRENT_IMPORTS=1
DISPATCH_MAX_SOLVE_QUEUE=8
