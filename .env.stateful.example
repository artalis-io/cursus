# Copy outside Git or to .env.stateful (ignored). Never reuse production names,
# ports, directories, database credentials, or R2 buckets for staging.
COMPOSE_PROJECT_NAME=cursus-stateful-staging-primary
CURSUS_NODE_NAME=spark-7468-staging
CURSUS_REVISION=replace-with-cursus-git-sha
OTTO_REVISION=367061d015f6776f7ea27fb01726c1a14cb4614c
OTTO_ROOT=./vendor/otto

CURSUS_STAGING_PORT=18091
CURSUS_STAGING_STATE_PATH=/srv/cursus-staging/state
CURSUS_DATASET_PATH=/absolute/path/to/external-customer-dataset
OSM_DATA_PATH=/srv/cursus-staging/osm
OSM_ASSET_NAME=hungary
OSM_PBF_FILE=hungary-latest.osm.pbf

# The primary binds only its trusted private address. The secondary points its
# CURSUS_DATABASE_URL at that address during normal operation.
CURSUS_POSTGRES_BIND_IP=192.0.2.10
CURSUS_POSTGRES_HOST_PORT=55432
CURSUS_POSTGRES_DATA_PATH=/srv/cursus-staging/postgres
CURSUS_POSTGRES_BACKUP_PATH=/srv/cursus-staging/postgres-backups
CURSUS_POSTGRES_RESTORE_PATH=/srv/cursus-staging/postgres-restore-drill
CURSUS_POSTGRES_PASSWORD_PATH=/srv/cursus-staging/secrets/postgres_password
CURSUS_POSTGRES_REPLICATION_PASSWORD_PATH=/srv/cursus-staging/secrets/postgres_replication_password
CURSUS_DATABASE_URL_PATH=/srv/cursus-staging/secrets/database_url
CURSUS_REPLICATION_CIDR=192.168.50.0/24
CURSUS_PRIMARY_HOST=192.0.2.10
CURSUS_PRIMARY_PORT=55432
# database_url contains the complete PostgreSQL URL (including an URL-encoded
# password) and is mounted as a secret; it is not stored in this env file.

# A dedicated non-production R2 bucket/token is required for workflow tests.
CURSUS_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
CURSUS_R2_BUCKET=cursus-staging
CURSUS_R2_ACCESS_KEY_ID_PATH=/srv/cursus-staging/secrets/r2_access_key_id
CURSUS_R2_SECRET_ACCESS_KEY_PATH=/srv/cursus-staging/secrets/r2_secret_access_key

# Keep the allowlist and Resend key external. The example defaults auth off so
# loopback-only staging can be exercised without sending login email.
CURSUS_AUTH_REQUIRED=0
CURSUS_AUTH_ALLOWED_EMAILS_PATH=/srv/cursus-staging/secrets/auth_allowlist
RESEND_API_KEY_PATH=/srv/cursus-staging/secrets/resend_api_key
CURSUS_PUBLIC_ORIGIN=http://127.0.0.1:18091
CURSUS_AUTH_FROM=Cursus <login@cursus.artalis.io>
CURSUS_TENANT_ID=staging
CURSUS_TENANT_NAME=Cursus staging

# Initial generous ceilings; replace only after recording measured peaks.
CURSUS_APP_CPUS=12
CURSUS_APP_MEMORY=24g
CURSUS_VELO_CPUS=4
CURSUS_VELO_MEMORY=8g
CURSUS_CARTA_CPUS=2
CURSUS_CARTA_MEMORY=4g
DISPATCH_MAX_CONCURRENT_SOLVES=1
DISPATCH_MAX_CONCURRENT_IMPORTS=1
